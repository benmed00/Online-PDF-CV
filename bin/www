#!/usr/bin/env node

/**
 * Module dependencies.
 */

const app = require('../app');
const debug = require('debug')('cv:server');
const http = require('http');
const logger = require('../utils/logger');

process.on('uncaughtException', err => {
  logger.error('UNCAUGHT EXCEPTION! 💥 Shutting down...');
  logger.error(err.name, err.message);
  process.exit(1);
});

/**
 * Get port from environment and store in Express.
 */

const port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

console.log('🚀 Starting server...');
console.log('📦 Application: benyakoub-cv');
console.log('🔧 Environment:', process.env.NODE_ENV || 'development');
console.log('🌐 Port:', port);

/**
 * Create HTTP server.
 */

const server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  const port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    console.error('❌ Server error:', error.message);
    throw error;
  }

  var bind = typeof port === 'string' ? 'Pipe ' + port : 'Port ' + port;

  // handle specific listen errors with friendly messages
  console.error('❌ Failed to start server on', bind);
  switch (error.code) {
    case 'EACCES':
      console.error('🔒 Error: ' + bind + ' requires elevated privileges');
      console.error('💡 Try running as administrator or use a port > 1024');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error('🚫 Error: ' + bind + ' is already in use');
      console.error('💡 Try using a different port or stop the other process');
      console.error('💡 You can set a different port: SET PORT=3001 && npm start');
      process.exit(1);
      break;
    default:
      console.error('❌ Unexpected error:', error.message);
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string' ? 'pipe ' + addr : 'port ' + addr.port;

  // Always show these messages (not just in debug mode)
  console.log('✅ Server successfully started!');
  console.log('🌍 Local URL: http://localhost:' + addr.port);
  console.log('📄 Your resume is available at: http://localhost:' + addr.port);
  console.log('📚 API documentation: http://localhost:' + addr.port + '/docs');
  console.log('🔍 Resume analyzer: http://localhost:' + addr.port + '/analyzer');
  console.log('⚖️  Resume comparison: http://localhost:' + addr.port + '/compare');
  console.log('📊 API versions: http://localhost:' + addr.port + '/api/versions');
  console.log('');
  console.log('Press Ctrl+C to stop the server');

  // Keep the debug message for development
  debug('Listening on ' + bind);
}

process.on('unhandledRejection', err => {
  logger.error('UNHANDLED REJECTION! 💥 Shutting down...');
  logger.error(err.name, err.message);
  server.close(() => {
    process.exit(1);
  });
});
