{
  "name": "benyakoub-cv",
  "version": "3.6.2",
  "description": "Host your PDF resume online with Express and Firebase Hosting, including multi-version delivery, API docs, and analysis tools.",
  "private": true,
  "author": "Jacob Son <ben94med@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://benyakoub-cv.firebaseapp.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benmed00/Online-PDF-CV.git"
  },
  "bugs": {
    "url": "https://github.com/benmed00/Online-PDF-CV/issues",
    "email": "ben94med@gmail.com"
  },
  "keywords": [
    "resume",
    "cv",
    "pdf",
    "express",
    "firebase",
    "hosting",
    "portfolio",
    "online-cv"
  ],
  "main": "app.js",
  "engines": {
    "node": ">=16.17.1"
  },
  "scripts": {
    "start": "node ./bin/www",
    "dev": "node app.js",
    "deploy": "firebase deploy",
    "build": "node scripts/build-static.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:artifacts": "node scripts/copy-playwright-artifacts.js",
    "test:all": "npm test && npm run build && npm run test:e2e && npm run test:e2e:artifacts",
    "add-version": "node scripts/add-resume-version.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "create-template": "node scripts/create-resume-template.js",
    "export": "node scripts/export-resume.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "debug": "^4.3.4",
    "express": "^5.1.0",
    "firebase": "^12.1.0",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "pug": "^3.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^30.0.5",
    "@playwright/test": "^1.52.0",
    "prettier": "^3.1.1",
    "supertest": "^7.1.4"
  }
}
