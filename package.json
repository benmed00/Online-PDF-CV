{
  "name": "benyakoub-cv",
  "version": "4.1.0",
  "description": "Host your PDF resume online with Express and Firebase Hosting, including multi-version delivery, API docs, and analysis tools.",
  "private": true,
  "author": "Jacob Son <ben94med@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://benyakoub-cv.firebaseapp.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benmed00/Online-PDF-CV.git"
  },
  "bugs": {
    "url": "https://github.com/benmed00/Online-PDF-CV/issues",
    "email": "ben94med@gmail.com"
  },
  "keywords": [
    "resume",
    "cv",
    "pdf",
    "express",
    "firebase",
    "hosting",
    "portfolio",
    "online-cv"
  ],
  "main": "app.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "start": "node ./bin/www",
    "dev": "node app.js",
    "deploy": "firebase deploy",
    "build": "node scripts/build-static.js",
    "validate": "npm run format:check && npm run lint && npm run audit:check && npm run version:check && npm run test:coverage && npm run build",
    "validate:full": "npm run validate && npm run test:e2e",
    "precommit": "npx lint-staged && npm run format:check && npm run lint",
    "audit:check": "npm audit --audit-level=high",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:analyzer": "playwright test e2e/analyzer-workflow.spec.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:artifacts": "node scripts/copy-playwright-artifacts.js",
    "test:all": "npm run validate:full && npm run test:e2e:artifacts",
    "add-version": "node scripts/add-resume-version.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "create-template": "node scripts/create-resume-template.js",
    "export": "node scripts/export-resume.js",
    "version:sync": "node scripts/sync-version.js",
    "version:check": "node scripts/sync-version.js --check",
    "version:patch": "node scripts/sync-version.js --patch",
    "version:minor": "node scripts/sync-version.js --minor",
    "version:major": "node scripts/sync-version.js --major"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "debug": "^4.3.4",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "firebase": "^12.1.0",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.0",
    "multer": "^2.1.1",
    "officeparser": "^7.2.1",
    "pug": "^3.0.3",
    "tesseract.js": "^7.0.0",
    "winston": "^3.17.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^30.0.5",
    "prettier": "^3.1.1",
    "supertest": "^7.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css,html,pug}": "prettier --write"
  }
}
