# Copy to `.env` and fill in your values. Never commit `.env` to git.

# VirusTotal — scans uploaded CV files for malware before text extraction
# Get a key: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Optional: OpenAI — AI coach tab on /analyzer (set OPENAI_MODEL to override default gpt-4o-mini)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
