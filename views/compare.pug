extends layout

block content
  h1= title

  section.intro
    p This tool allows you to compare different versions of your resume side by side.
    p Select two resume versions from the dropdown menus below to compare them.

  section.compare-tool
    .version-selectors
      .version-selector
        label(for='version1') First Version:
        select#version1
          each version in versions
            option(value=version)= version

      .version-selector
        label(for='version2') Second Version:
        select#version2
          each version in versions
            if version !== versions[0]
              option(value=version, selected)= version
            else
              option(value=version)= version

    button#compare-btn.btn Compare Resumes

  section#comparison.comparison-view.hidden
    .pdf-container
      .pdf-view
        h3#pdf1-title
        iframe#pdf1-frame(width='100%', height='600px')

      .pdf-view
        h3#pdf2-title
        iframe#pdf2-frame(width='100%', height='600px')

  section.tips
    h2 Why Compare Resume Versions?
    ul
      li Different job applications may require emphasizing different skills and experiences
      li Comparing versions helps ensure consistency in your professional branding
      li You can identify strengths and weaknesses in each version
      li It helps you tailor your resume more effectively for specific roles

block scripts
  script.
    document.addEventListener('DOMContentLoaded', function () {
      const version1Select = document.getElementById('version1');
      const version2Select = document.getElementById('version2');
      const compareBtn = document.getElementById('compare-btn');
      const comparisonSection = document.getElementById('comparison');
      const pdf1Frame = document.getElementById('pdf1-frame');
      const pdf2Frame = document.getElementById('pdf2-frame');
      const pdf1Title = document.getElementById('pdf1-title');
      const pdf2Title = document.getElementById('pdf2-title');

      // Set initial different values if possible
      if (version1Select.options.length > 1 && version1Select.value === version2Select.value) {
        version2Select.selectedIndex = 1;
      }

      compareBtn.addEventListener('click', function () {
        const version1 = version1Select.value;
        const version2 = version2Select.value;

        // Update iframe sources
        pdf1Frame.src = `/resume/${version1}`;
        pdf2Frame.src = `/resume/${version2}`;

        // Update titles
        pdf1Title.textContent = `${version1.charAt(0).toUpperCase() + version1.slice(1)} Version`;
        pdf2Title.textContent = `${version2.charAt(0).toUpperCase() + version2.slice(1)} Version`;

        // Show comparison section
        comparisonSection.classList.remove('hidden');

        // Scroll to comparison section
        comparisonSection.scrollIntoView({ behavior: 'smooth' });
      });
    });

  style.
    .version-selectors {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 20px;
    }

    .version-selector {
      flex: 1;
      min-width: 200px;
    }

    label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
    }

    select {
      width: 100%;
      padding: 8px;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-size: 16px;
    }

    .btn {
      background-color: #3498db;
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 16px;
    }

    .btn:hover {
      background-color: #2980b9;
    }

    .hidden {
      display: none;
    }

    .comparison-view {
      margin-top: 30px;
    }

    .pdf-container {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    .pdf-view {
      flex: 1;
      min-width: 300px;
      border: 1px solid #ddd;
      border-radius: 5px;
      padding: 10px;
    }

    h3 {
      text-align: center;
      margin-top: 0;
    }

    iframe {
      border: none;
      background-color: #f5f5f5;
    }

    @media (max-width: 768px) {
      .pdf-container {
        flex-direction: column;
      }
    }
