extends layout

block content
  h1= title

  #compare-alert.alert-banner(role='alert', aria-live='polite')
    span#compare-alert-message
    button.alert-close(type='button', aria-label='Dismiss') ×

  section.intro
    p This tool allows you to compare different versions of your resume side by side.
    p Select two resume versions from the dropdown menus below to compare them.

  section.compare-tool
    .version-selectors
      .version-selector
        label(for='version1') First Version:
        select#version1
          each version in versions
            option(value=version)= version

      .version-selector
        label(for='version2') Second Version:
        select#version2
          each version in versions
            if version !== versions[0]
              option(value=version, selected)= version
            else
              option(value=version)= version

    button#compare-btn.btn Compare Resumes

  section#comparison.comparison-view.hidden
    .pdf-container
      .pdf-view
        h3#pdf1-title
        #pdf1-loading.pdf-loading Loading PDF…
        p#pdf1-error.pdf-error.hidden(role='alert') Could not load this PDF.
        iframe#pdf1-frame(width='100%', height='600px', title='First resume version')

      .pdf-view
        h3#pdf2-title
        #pdf2-loading.pdf-loading Loading PDF…
        p#pdf2-error.pdf-error.hidden(role='alert') Could not load this PDF.
        iframe#pdf2-frame(width='100%', height='600px', title='Second resume version')

  section.tips
    h2 Why Compare Resume Versions?
    ul
      li Different job applications may require emphasizing different skills and experiences
      li Comparing versions helps ensure consistency in your professional branding
      li You can identify strengths and weaknesses in each version
      li It helps you tailor your resume more effectively for specific roles

block scripts
  script.
    document.addEventListener('DOMContentLoaded', function () {
      const version1Select = document.getElementById('version1');
      const version2Select = document.getElementById('version2');
      const compareBtn = document.getElementById('compare-btn');
      const comparisonSection = document.getElementById('comparison');
      const alertBanner = document.getElementById('compare-alert');
      const alertMessage = document.getElementById('compare-alert-message');

      function showAlert(message) {
        alertMessage.textContent = message;
        alertBanner.className = 'alert-banner visible error';
      }

      function hideAlert() {
        alertBanner.classList.remove('visible');
      }

      function setupPdfFrame(frameId, loadingId, errorId) {
        const frame = document.getElementById(frameId);
        const loading = document.getElementById(loadingId);
        const errorEl = document.getElementById(errorId);
        let loaded = false;

        frame.addEventListener('load', function () {
          loaded = true;
          loading.classList.add('hidden');
          errorEl.classList.add('hidden');
        });

        return function (src) {
          loaded = false;
          loading.classList.remove('hidden');
          errorEl.classList.add('hidden');
          frame.src = src;

          setTimeout(function () {
            if (!loaded) {
              loading.classList.add('hidden');
              errorEl.classList.remove('hidden');
            }
          }, 8000);
        };
      }

      const loadPdf1 = setupPdfFrame('pdf1-frame', 'pdf1-loading', 'pdf1-error');
      const loadPdf2 = setupPdfFrame('pdf2-frame', 'pdf2-loading', 'pdf2-error');

      if (version1Select.options.length > 1 && version1Select.value === version2Select.value) {
        version2Select.selectedIndex = 1;
      }

      const params = new URLSearchParams(window.location.search);
      const q1 = params.get('v1');
      const q2 = params.get('v2');
      if (q1) {
        for (const opt of version1Select.options) {
          if (opt.value === q1) version1Select.value = q1;
        }
      }
      if (q2) {
        for (const opt of version2Select.options) {
          if (opt.value === q2) version2Select.value = q2;
        }
      }
      if (q1 && q2 && q1 !== q2) {
        compareBtn.click();
      }

      compareBtn.addEventListener('click', function () {
        const version1 = version1Select.value;
        const version2 = version2Select.value;

        hideAlert();

        if (version1 === version2) {
          showAlert('Please select two different versions to compare.');
          return;
        }

        document.getElementById('pdf1-title').textContent = `${version1.charAt(0).toUpperCase() + version1.slice(1)} Version`;
        document.getElementById('pdf2-title').textContent = `${version2.charAt(0).toUpperCase() + version2.slice(1)} Version`;

        loadPdf1(`/resume/${version1}`);
        loadPdf2(`/resume/${version2}`);

        comparisonSection.classList.remove('hidden');
        comparisonSection.scrollIntoView({ behavior: 'smooth' });
      });

      document.querySelector('.alert-close')?.addEventListener('click', hideAlert);
    });

  style.
    .version-selectors {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-bottom: 20px;
    }

    .version-selector {
      flex: 1;
      min-width: 200px;
    }

    label {
      display: block;
      margin-bottom: 5px;
      font-weight: bold;
    }

    select {
      width: 100%;
      padding: 8px;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-size: 16px;
    }

    .btn {
      background-color: #3498db;
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 16px;
    }

    .btn:hover {
      background-color: #2980b9;
    }

    .hidden {
      display: none;
    }

    .comparison-view {
      margin-top: 30px;
    }

    .pdf-container {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    .pdf-view {
      flex: 1;
      min-width: 300px;
      border: 1px solid #ddd;
      border-radius: 5px;
      padding: 10px;
    }

    h3 {
      text-align: center;
      margin-top: 0;
    }

    iframe {
      border: none;
      background-color: #f5f5f5;
    }

    .pdf-loading {
      text-align: center;
      padding: 1rem;
      color: #666;
    }

    .pdf-error {
      text-align: center;
      padding: 1rem;
      color: #991b1b;
      background: #fef2f2;
      border-radius: 4px;
    }

    .alert-banner {
      display: none;
      padding: 1rem;
      margin-bottom: 1rem;
      border-radius: 4px;
    }

    .alert-banner.visible {
      display: block;
    }

    .alert-banner.error {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #991b1b;
    }

    @media (max-width: 768px) {
      .pdf-container {
        flex-direction: column;
      }
    }
