extends layout

block content
  .error-container
    h1.error-title Error: #{error.status || error.statusCode || 500}
    h2.error-message= message
    p.error-description Something went wrong. Please try again or return to the home page.

    a.btn.error-home-btn(href="/") Return to Home

    if error.stack && process.env.NODE_ENV === 'development'
      .error-details
        h3 Error Details (Development Only)
        pre.error-stack #{error.stack}

  style.
    .error-container {
      text-align: center;
      padding: 40px 20px;
    }

    .error-title {
      font-size: 48px;
      color: #e74c3c;
      margin-bottom: 10px;
    }

    .error-message {
      font-size: 24px;
      color: #7f8c8d;
      margin-bottom: 30px;
    }

    .error-description {
      font-size: 18px;
      margin-bottom: 30px;
    }

    .error-home-btn {
      display: inline-block;
      background-color: #3498db;
      color: white;
      padding: 12px 24px;
      border-radius: 4px;
      text-decoration: none;
      font-weight: bold;
      margin-bottom: 40px;
    }

    .error-home-btn:hover {
      background-color: #2980b9;
      text-decoration: none;
    }

    .error-details {
      margin-top: 40px;
      text-align: left;
      border-top: 1px solid #eee;
      padding-top: 20px;
    }

    .error-stack {
      background-color: #f8f9fa;
      padding: 15px;
      border-radius: 5px;
      overflow-x: auto;
      font-size: 14px;
      text-align: left;
    }
